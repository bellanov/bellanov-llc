{
  "name": "bellanov-llc",
  "version": "0.1.0",
  "description": "Templates for developing web applications with HTMX, HTML, CSS, and Node.js/Express.",
  "main": "views/bellanov/server.js",
  "scripts": {
    "build": "echo 'Building...'",
    "start": "node views/bellanov/server.js",
    "start-components": "node views/bellanov/server.js",
    "dev": "nodemon views/bellanov/server.js",
    "dev-components": "nodemon views/components/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "format": "eslint views --fix; npx prettier --write views/bellanov/public/*.html *.md",
    "lint": "eslint views; npx prettier --check views/bellanov/public/*.html *.md"
  },
  "keywords": [
    "htmx",
    "template",
    "express",
    "html"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "htmx.org": "^2.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.7",
    "supertest": "^7.3.1"
  }
}
